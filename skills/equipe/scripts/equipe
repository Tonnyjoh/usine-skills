#!/usr/bin/env python3
"""Outil de la skill equipe : établit les faits et tient les garde-fous.

Le modèle décide et coordonne ; ce script répond à ce qu'il ne doit pas supposer
(topologie, stacks, respect des périmètres, résultat réel des vérifications) et
refuse les passages de phase dont la condition n'est pas remplie.

Sortie : JSON sur stdout. Codes : 0 ok, 2 garde-fou bloquant ou usage, 3 tours épuisés.
Stdlib uniquement.
"""
import argparse
import datetime
import fnmatch
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent.parent
ASSETS = SKILL_DIR / "assets"
IGNORES = {"node_modules", "vendor", "target", "build", "dist", ".next", ".nuxt", "venv",
           ".venv", "__pycache__", ".dart_tool", ".gradle", ".idea", ".vscode", "coverage"}
ROLES_DEV = "developpeur"
ROLES_QUALITE = {"testeur", "relecteur", "securite"}
ROLES_CONCEPTION = {"ux", "documentation"}
MAX_TOURS = 3
MARQUE_AGENT = "<!-- Généré par /equipe composer."
DEBUT_SECTION = "<!-- equipe:debut -->"
FIN_SECTION = "<!-- equipe:fin -->"
FONCTIONS = {"backend": "le backend", "frontend": "l'interface web", "mobile": "l'application mobile",
             "donnees": "le schéma, les migrations et les requêtes", "devops": "l'outillage de build et de déploiement"}


def emit(obj, code=0):
    print(json.dumps(obj, ensure_ascii=False, indent=2))
    sys.exit(code)


def bloque(code, message, **extra):
    emit({"statut": "bloque", "code": code, "message": message, **extra}, 2)


def maintenant():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def sha(data):
    return hashlib.sha256(data).hexdigest()[:16]


def sha_fichier(path):
    try:
        return sha(Path(path).read_bytes())
    except OSError:
        return None


def git(rep, *args):
    try:
        r = subprocess.run(["git", "-c", "core.quotepath=off", "-C", str(rep), *args],
                           capture_output=True, text=True, errors="replace")
    except (OSError, ValueError):
        return 127, ""
    return r.returncode, r.stdout.strip("\n")


def toplevel(rep):
    code, out = git(rep, "rev-parse", "--show-toplevel")
    return Path(out) if code == 0 and out else None


def trouver_racine():
    cwd = Path.cwd()
    for d in [cwd, *cwd.parents]:
        if (d / ".equipe" / "team.json").is_file():
            return d
    return cwd


RACINE = trouver_racine()
TEAM_PATH = RACINE / ".equipe" / "team.json"
FEATURES_DIR = RACINE / ".equipe" / "fonctionnalites"


# ---------------------------------------------------------------- détection

def lire(path):
    try:
        return Path(path).read_text(errors="replace")
    except OSError:
        return ""


def _node(d):
    try:
        pkg = json.loads(lire(d / "package.json"))
    except ValueError:
        return None
    deps = {**pkg.get("dependencies", {}), **pkg.get("devDependencies", {})}
    scripts = pkg.get("scripts", {})
    pm = "npm"
    install = "npm install"
    if (d / "pnpm-lock.yaml").exists():
        pm, install = "pnpm", "pnpm install --frozen-lockfile"
    elif (d / "yarn.lock").exists():
        pm, install = "yarn", "yarn install --frozen-lockfile"
    elif (d / "bun.lockb").exists() or (d / "bun.lock").exists():
        pm, install = "bun", "bun install --frozen-lockfile"
    elif (d / "package-lock.json").exists():
        install = "npm ci"
    verifs = []
    for nom in ("lint", "typecheck", "test"):
        s = scripts.get(nom, "")
        if s and "no test specified" not in s:
            verifs.append(f"{pm} run {nom}")
    verif = " && ".join(verifs) or None
    specs = [("@nestjs/core", "backend", "Node.js / NestJS"), ("@angular/core", "frontend", "Angular"),
             ("next", "frontend", "Next.js"), ("nuxt", "frontend", "Vue / Nuxt"),
             ("react-native", "mobile", "React Native"), ("expo", "mobile", "React Native"),
             ("vue", "frontend", "Vue / Nuxt"), ("react", "frontend", "React"),
             ("express", "backend", "Node.js / Express")]
    for dep, role, spec in specs:
        if dep in deps:
            return role, spec, verif, install
    return "autre", "Node.js (à préciser)", verif, install


def _java(d):
    pom = d / "pom.xml"
    cmd = "./mvnw -q test" if (d / "mvnw").exists() else "mvn -q test"
    spec = "Java / Spring Boot" if "spring-boot" in lire(pom) else "Java (à préciser)"
    return "backend", spec, cmd, None


def _gradle(d):
    txt = lire(d / "build.gradle") + lire(d / "build.gradle.kts") + lire(d / "app" / "build.gradle.kts")
    cmd = "./gradlew test" if (d / "gradlew").exists() else "gradle test"
    if "androidx.compose" in txt or "compose = true" in txt:
        return "mobile", "Kotlin / Jetpack Compose", cmd, None
    if "spring-boot" in txt or "org.springframework.boot" in txt:
        return "backend", "Java / Spring Boot", cmd, None
    if "com.android" in txt:
        return "mobile", "Android (à préciser)", cmd, None
    return "backend", "JVM (à préciser)", cmd, None


def _python(d):
    txt = (lire(d / "pyproject.toml") + lire(d / "requirements.txt")).lower()
    if "fastapi" in txt:
        spec = "Python / FastAPI"
    elif "django" in txt:
        spec = "Python / Django"
    else:
        spec = "Python (à préciser)"
    install = "pip install -r requirements.txt" if (d / "requirements.txt").exists() else "pip install -e ."
    return "backend", spec, "pytest", install


def _dotnet(d):
    return "backend", ".NET / ASP.NET Core", "dotnet test", "dotnet restore"


DETECTEURS = [
    (("package.json",), _node),
    (("pom.xml",), _java),
    (("build.gradle", "build.gradle.kts"), _gradle),
    (("pyproject.toml", "requirements.txt"), _python),
    (("pubspec.yaml",), lambda d: ("mobile", "Flutter", "flutter test", "flutter pub get")),
    (("composer.json",), lambda d: ("backend", "PHP / Laravel" if (d / "artisan").exists() else "PHP (à préciser)",
                                    "php artisan test" if (d / "artisan").exists() else "vendor/bin/phpunit",
                                    "composer install")),
    (("go.mod",), lambda d: ("backend", "Go", "go test ./...", "go mod download")),
    (("Package.swift",), lambda d: ("mobile", "Swift / SwiftUI", "swift test", None)),
]


def detecter_dossier(d):
    for manifestes, fn in DETECTEURS:
        if any((d / m).exists() for m in manifestes):
            return fn(d)
    try:
        if any(p.suffix in (".csproj", ".sln") for p in d.iterdir()):
            return _dotnet(d)
    except OSError:
        pass
    return None


def sous_dossiers(racine, profondeur):
    pile = [(racine, 0)]
    while pile:
        d, n = pile.pop()
        yield d
        if n >= profondeur:
            continue
        try:
            enfants = sorted(p for p in d.iterdir() if p.is_dir())
        except OSError:
            continue
        for e in enfants:
            if e.name.startswith(".") or e.name in IGNORES:
                continue
            pile.append((e, n + 1))


def indices_complementaires(racine, stacks):
    indices = {"donnees": [], "devops": [], "tests": []}
    for d in sous_dossiers(racine, 2):
        rel = os.path.relpath(d, racine)
        if d.name in ("migrations", "prisma", "alembic") or rel.endswith("resources/db"):
            indices["donnees"].append(rel)
        if d.name in ("test", "tests", "__tests__", "e2e", "spec", "integration_test"):
            indices["tests"].append(rel)
    if (racine / ".github" / "workflows").is_dir():
        indices["devops"].append(".github")
    if (racine / ".gitlab-ci.yml").exists():
        indices["devops"].append(".gitlab-ci.yml")
    for nom in ("Dockerfile", "compose.yaml", "docker-compose.yml"):
        if (racine / nom).exists():
            indices["devops"].append(nom)
    for s in stacks:
        rt = racine / s["chemin"] / "src" / "test"
        if rt.is_dir():
            indices["tests"].append(os.path.relpath(rt, racine))
    indices["tests"] = sorted(set(indices["tests"]))
    return indices


def depots_enfants(racine, profondeur=2):
    res = []
    for d in sous_dossiers(racine, profondeur):
        if d != racine and (d / ".git").exists():
            res.append(d)
    return res


def depots_recents(racine):
    trouves = []
    for d in sous_dossiers(racine, 3):
        if (d / ".git").exists():
            code, out = git(d, "log", "-1", "--format=%ct %cs")
            if code == 0 and out:
                ts, date = out.split(" ", 1)
                trouves.append((int(ts), os.path.relpath(d, racine), date))
    trouves.sort(reverse=True)
    return [{"chemin": c, "dernier_commit": dt} for _, c, dt in trouves[:8]]


def detecter_topologie(racine):
    top = toplevel(racine)
    if top:
        return "mono-depot"
    return "multi-depots" if depots_enfants(racine) else "sans-git"


def detecter_stacks(racine):
    stacks = []
    for d in sous_dossiers(racine, 2):
        det = detecter_dossier(d)
        if det:
            role, spec, verif, install = det
            stacks.append({"chemin": os.path.relpath(d, racine), "role_suggere": role, "specialite_suggeree": spec,
                           "verification_suggeree": verif, "installation_suggeree": install})
    stacks.sort(key=lambda s: s["chemin"])
    return stacks


# ---------------------------------------------------------------- équipe

def charger_equipe(obligatoire=True):
    if not TEAM_PATH.is_file():
        if obligatoire:
            bloque("EQUIPE_ABSENTE", "Pas de .equipe/team.json ici : lancer /equipe composer depuis la racine du projet.")
        return None
    try:
        return json.loads(TEAM_PATH.read_text())
    except ValueError as e:
        bloque("EQUIPE_INVALIDE", f".equipe/team.json n'est pas du JSON valide : {e}")


def actifs(team, role=None):
    res = [a for a in team.get("agents", []) if a.get("actif", True)]
    return [a for a in res if a.get("role") == role] if role else res


def agent_par_nom(team, nom):
    for a in team.get("agents", []):
        if a.get("nom") == nom:
            return a
    bloque("AGENT_INCONNU", f"Agent « {nom} » absent de .equipe/team.json.")


def norm(chemin):
    return chemin.strip().strip("/").removeprefix("./") or "."


def prefixe_fixe(motif):
    m = norm(motif)
    pos = min((m.find(c) for c in "*?[" if c in m), default=-1)
    return m if pos < 0 else m[:pos].rsplit("/", 1)[0] if "/" in m[:pos] else "."


def dans_perimetre(fichier, perimetre):
    for p in perimetre:
        p = norm(p)
        if p == ".":
            return True
        if any(c in p for c in "*?["):
            if fnmatch.fnmatch(fichier, p):
                return True
        elif fichier == p or fichier.startswith(p + "/"):
            return True
    return False


def chevauchements(devs):
    res = []
    for i, a in enumerate(devs):
        for b in devs[i + 1:]:
            for pa in a.get("perimetre", []):
                for pb in b.get("perimetre", []):
                    x, y = prefixe_fixe(pa), prefixe_fixe(pb)
                    if x == "." or y == "." or x == y or x.startswith(y + "/") or y.startswith(x + "/"):
                        res.append({"agents": [a["nom"], b["nom"]], "chemins": [pa, pb]})
    return res


def valider_composition(team):
    """Règles de composition du prompt d'origine."""
    pb = []
    devs = actifs(team, ROLES_DEV)
    if not devs:
        pb.append({"code": "AUCUN_DEVELOPPEUR", "gravite": "bloquant",
                   "message": "Aucun développeur actif : demander à l'utilisateur quoi faire."})
    if len(devs) > 1:
        for c in chevauchements(devs):
            pb.append({"code": "PERIMETRES_CHEVAUCHANTS", "gravite": "bloquant",
                       "message": f"{c['agents'][0]} et {c['agents'][1]} se chevauchent : {c['chemins'][0]} / {c['chemins'][1]}."})
        if not team.get("projet", {}).get("contrat"):
            pb.append({"code": "CONTRAT_REQUIS", "gravite": "bloquant",
                       "message": "Plusieurs développeurs actifs : un contrat d'API ou d'interface est obligatoire."})
    if len(actifs(team)) > 4:
        pb.append({"code": "COUT_ELEVE", "gravite": "avertissement",
                   "message": f"{len(actifs(team))} agents actifs : prévenir du coût en tokens et proposer une version réduite."})
    for a in actifs(team):
        for champ in ("nom", "role", "specialite", "perimetre"):
            if a.get(champ) in (None, "") or "<" in str(a.get(champ, "")):
                pb.append({"code": "CHAMP_INCOMPLET", "gravite": "bloquant",
                           "message": f"Agent {a.get('nom', '?')} : champ « {champ} » vide ou resté entre <...>."})
        if a.get("role") in (ROLES_DEV, "testeur") and not a.get("verification"):
            pb.append({"code": "VERIFICATION_ABSENTE", "gravite": "bloquant",
                       "message": f"Agent {a.get('nom')} : commande de vérification manquante."})
    return pb


def bloquants(pbs):
    return [p for p in pbs if p["gravite"] == "bloquant"]


def consignes_pour(agent):
    if agent.get("consignes"):
        return agent["consignes"]
    cat = json.loads((ASSETS / "catalogue.json").read_text())
    spec = agent.get("specialite", "").lower()
    for famille in cat.values():
        for nom, texte in famille.items():
            if nom.lower() == spec:
                return texte
    return "Spécialité hors catalogue : explore le dépôt et suis ses conventions réelles."


def rendre_agent(team, a):
    role = a["role"]
    perim = ", ".join(a.get("perimetre", [])) or "aucun (lecture seule)"
    v = {"NOM": a["nom"], "SPECIALITE": a["specialite"], "PERIMETRE": perim, "MODELE": a.get("modele", "sonnet"),
         "COMMANDE_VERIF": a.get("verification") or "aucune", "INSTALLATION": a.get("installation") or "aucune"}
    if role == ROLES_DEV:
        gabarit = "developpeur.md"
        v["FONCTION"] = a.get("fonction") or FONCTIONS.get(a["nom"].split("-")[0], f"la partie {a['nom']}")
        v["CONSIGNES"] = consignes_pour(a)
    elif role == "testeur":
        gabarit = "testeur.md"
    elif role in ("relecteur", "securite"):
        gabarit = "lecture-seule.md"
        rel = role == "relecteur"
        v["TITRE_DESCRIPTION"] = "Relecteur de code" if rel else "Revue de sécurité"
        v["TITRE_ROLE"] = "relecteur" if rel else "spécialiste sécurité"
        v["POINTS"] = ("Erreurs de logique, cas limites oubliés, duplication, lisibilité, respect de l'architecture, tests manquants."
                       if rel else "Injection, contrôle d'accès et droits, gestion des secrets, validation des entrées, données sensibles dans les logs, dépendances vulnérables, configuration CORS et en-têtes.")
    elif role in ROLES_CONCEPTION:
        gabarit = "conception.md"
        ux = role == "ux"
        v["TITRE_DESCRIPTION"] = "UX" if ux else "Documentation"
        v["TITRE_ROLE"] = "ux" if ux else "documentation"
        v["POINTS"] = ("Décris parcours, états d'interface (chargement, vide, erreur, accès refusé), accessibilité et textes, d'après la spec. Propose, ne décide pas à la place de l'utilisateur."
                       if ux else "Documente ce qui existe réellement (lis le code et la spec) ; n'invente ni comportement ni commande.")
    else:
        bloque("ROLE_INCONNU", f"Agent {a['nom']} : rôle « {role} » inconnu.")
    texte = (ASSETS / "agents" / gabarit).read_text()
    for k, val in v.items():
        texte = texte.replace("{{" + k + "}}", val)
    return texte


def tableau_equipe(team):
    lignes = ["| Agent | Spécialité | Périmètre | Vérification | Modèle |", "|---|---|---|---|---|"]
    for a in actifs(team):
        lignes.append(f"| {a['nom']} | {a['specialite']} | {', '.join(a.get('perimetre', [])) or 'lecture seule'} "
                      f"| `{a.get('verification') or '-'}` | {a.get('modele', 'sonnet')} |")
    return "\n".join(lignes)


def rendre_section_claude(team):
    t = (ASSETS / "claude-section.md").read_text().replace("{{TABLEAU}}", tableau_equipe(team))
    return f"{DEBUT_SECTION}\n{t.strip()}\n{FIN_SECTION}\n"


def chemin_spec(team, feature):
    return RACINE / team["projet"].get("dossier_specs", "docs/specs") / f"{feature}.md"


def chemin_contrat(team):
    c = team["projet"].get("contrat")
    return RACINE / c if c else None


def depots_equipe(team):
    tops = {}
    for a in actifs(team):
        top = toplevel(RACINE / a.get("depot", "."))
        if top:
            tops[str(top)] = top
    if not tops:
        for d in depots_enfants(RACINE):
            tops[str(d)] = d
    return list(tops.values())


# ---------------------------------------------------------------- empreintes

def fichiers_modifies(top):
    r = subprocess.run(["git", "-C", str(top), "status", "--porcelain", "-z", "-uall", "--no-renames"],
                       capture_output=True, text=True, errors="replace")
    if r.returncode != 0:
        return []
    res = []
    for e in r.stdout.split("\0"):
        if len(e) > 3:
            res.append(e[3:])
    return [f for f in res if not f.startswith(".equipe/") and "/.equipe/" not in f]


def empreinte(team):
    h = hashlib.sha256()
    for top in sorted(depots_equipe(team), key=str):
        _, head = git(top, "rev-parse", "HEAD")
        h.update(head.encode())
        for f in sorted(fichiers_modifies(top)):
            h.update(f.encode())
            h.update((sha_fichier(top / f) or "absent").encode())
    return h.hexdigest()[:16]


def hash_accord(team, feature):
    contrat = chemin_contrat(team)
    return {"spec": sha_fichier(chemin_spec(team, feature)), "contrat": sha_fichier(contrat) if contrat else None}


def chemin_etat(feature):
    return FEATURES_DIR / f"{feature}.json"


def charger_etat(feature):
    p = chemin_etat(feature)
    if not p.is_file():
        bloque("FONCTIONNALITE_INCONNUE", f"Aucun état pour « {feature} » : lancer `equipe demarrer {feature}`.")
    return json.loads(p.read_text())


def sauver_etat(etat):
    FEATURES_DIR.mkdir(parents=True, exist_ok=True)
    etat["maj"] = maintenant()
    chemin_etat(etat["fonctionnalite"]).write_text(json.dumps(etat, ensure_ascii=False, indent=2) + "\n")


def relatif_projet(top, fichier):
    return os.path.relpath(top / fichier, RACINE)


def instantane(team):
    res = {}
    for top in depots_equipe(team):
        for f in fichiers_modifies(top):
            res[relatif_projet(top, f)] = sha_fichier(top / f)
    return res


# ---------------------------------------------------------------- commandes

def cmd_context(args):
    team = charger_equipe(obligatoire=False)
    accueil = RACINE.resolve() == Path.home().resolve()
    directives = []
    res = {"racine": str(RACINE), "topologie": None, "stacks": [], "indices": {}, "depots": []}
    if accueil:
        directives.append({"code": "PAS_UN_PROJET", "message": "Dossier personnel : ne rien créer ici. Demander le projet, puis y travailler avec des chemins absolus ou faire relancer la session à sa racine."})
        res["depots_recents"] = depots_recents(RACINE)
        res["directives"] = directives
        emit(res)
    topo = detecter_topologie(RACINE)
    stacks = detecter_stacks(RACINE)
    res.update(topologie=topo, stacks=stacks, indices=indices_complementaires(RACINE, stacks))
    if topo == "mono-depot":
        top = toplevel(RACINE)
        _, branche = git(top, "branch", "--show-current")
        res["depots"] = [{"chemin": os.path.relpath(top, RACINE), "branche": branche, "modifications": len(fichiers_modifies(top))}]
        if top.resolve() != RACINE.resolve():
            directives.append({"code": "SOUS_DOSSIER", "message": f"La racine git est {top} : vérifier que le projet est bien ce sous-dossier."})
    elif topo == "multi-depots":
        for d in depots_enfants(RACINE):
            _, branche = git(d, "branch", "--show-current")
            res["depots"].append({"chemin": os.path.relpath(d, RACINE), "branche": branche, "modifications": len(fichiers_modifies(d))})
        directives.append({"code": "MULTI_DEPOTS", "message": "Plusieurs dépôts sous une racine sans git : pas de worktree, chaque dépôt isole son développeur. Placer specs et contrat dans le dépôt producteur pour qu'ils soient versionnés."})
    else:
        directives.append({"code": "SANS_GIT", "message": "Pas de git : ni worktree, ni contrôle de périmètre, ni empreinte de vérification. Proposer git init (avec accord) ou travailler en séquentiel."})
    if not stacks:
        directives.append({"code": "AUCUNE_STACK", "message": "Aucun manifeste reconnu : projet vide ou hors catalogue, explorer et demander."})
    if team is None:
        directives.append({"code": "EQUIPE_ABSENTE", "message": "Pas d'équipe composée : /equipe composer."})
    else:
        res["equipe"] = [{"nom": a["nom"], "role": a.get("role"), "specialite": a.get("specialite")} for a in actifs(team)]
        res["problemes_composition"] = valider_composition(team)
        for a in actifs(team):
            if not (RACINE / ".claude" / "agents" / f"{a['nom']}.md").is_file():
                directives.append({"code": "AGENT_NON_GENERE", "message": f"{a['nom']} n'a pas de fichier .claude/agents : equipe scaffold."})
        res["fonctionnalites"] = etats_resumes()
    res["directives"] = directives
    emit(res)


def etats_resumes():
    res = []
    if FEATURES_DIR.is_dir():
        for p in sorted(FEATURES_DIR.glob("*.json")):
            e = json.loads(p.read_text())
            res.append({"fonctionnalite": e["fonctionnalite"], "phase": e["phase"], "tours": e.get("tours", 0), "maj": e.get("maj")})
    return res


def cmd_catalogue(args):
    emit(json.loads((ASSETS / "catalogue.json").read_text()))


ALIAS = {"front": "frontend", "frontend": "frontend", "web": "frontend", "back": "backend", "backend": "backend", "api": "backend",
         "mobile": "mobile", "donnees": "donnees", "bdd": "donnees", "db": "donnees", "devops": "devops",
         "test": "testeur", "tests": "testeur", "testeur": "testeur", "relecteur": "relecteur", "review": "relecteur",
         "securite": "securite", "ux": "ux", "doc": "documentation", "docs": "documentation", "documentation": "documentation"}
DEFAUTS_ROLE = {"testeur": "tests d'acceptation et de contrat", "relecteur": "revue de code générale",
                "securite": "revue de sécurité applicative", "ux": "parcours, états d'interface, accessibilité",
                "documentation": "documentation technique et README"}


def agent_dev_propose(canon, stacks, a_confirmer):
    candidats = [s for s in stacks if s["role_suggere"] == canon]
    if not candidats and canon == "backend":
        candidats = [s for s in stacks if s["role_suggere"] == "autre"]
    if not candidats:
        a_confirmer.append(f"{canon} : aucune stack détectée, préciser spécialité, dossier et vérification.")
        return {"nom": canon, "role": ROLES_DEV, "actif": True, "specialite": "<à préciser>", "depot": ".",
                "perimetre": [canon], "verification": None, "modele": "sonnet"}
    s = candidats[0]
    if len(candidats) > 1:
        a_confirmer.append(f"{canon} : plusieurs dossiers possibles ({', '.join(c['chemin'] for c in candidats)}), {s['chemin']} retenu.")
    if "à préciser" in s["specialite_suggeree"]:
        a_confirmer.append(f"{canon} : spécialité à préciser ({s['chemin']}).")
    if not s["verification_suggeree"]:
        a_confirmer.append(f"{canon} : aucune commande de vérification trouvée dans {s['chemin']}.")
    return {"nom": canon, "role": ROLES_DEV, "actif": True, "specialite": s["specialite_suggeree"], "depot": s["chemin"],
            "perimetre": [s["chemin"]], "installation": s["installation_suggeree"],
            "verification": s["verification_suggeree"], "modele": "sonnet"}


def cmd_proposer(args):
    team = charger_equipe(obligatoire=False) or {
        "version": 1, "agents": [],
        "projet": {"nom": RACINE.name, "objectif": "", "dossier_specs": "docs/specs", "contrat": None}}
    stacks = detecter_stacks(RACINE)
    indices = indices_complementaires(RACINE, stacks)
    a_confirmer = []
    inconnus = [d for d in args.agents if d.lower() not in ALIAS]
    if inconnus:
        bloque("ROLE_INCONNU", f"Inconnu : {', '.join(inconnus)}. Connus : {', '.join(sorted(set(ALIAS.values())))}.")
    demandes = list(dict.fromkeys(ALIAS[d.lower()] for d in args.agents))
    # Les développeurs d'abord : la vérification du testeur s'en déduit.
    demandes.sort(key=lambda c: c in DEFAUTS_ROLE)
    for canon in demandes:
        existant = next((a for a in team["agents"] if a["nom"] == canon), None)
        if existant:
            existant["actif"] = True
        elif canon in DEFAUTS_ROLE:
            a = {"nom": canon, "role": canon, "actif": True, "specialite": DEFAUTS_ROLE[canon], "depot": ".", "perimetre": [], "modele": "sonnet"}
            if canon == "testeur":
                a["perimetre"] = indices["tests"]
                if not a["perimetre"]:
                    a["perimetre"] = ["tests"]
                    a_confirmer.append("testeur : pas de dossier de tests détecté, « tests » proposé.")
                devs = [x for x in actifs(team, ROLES_DEV) if x.get("verification")]
                if len(devs) == 1:
                    a["depot"], a["verification"] = devs[0]["depot"], devs[0]["verification"]
                    if a["depot"] != ".":
                        a["perimetre"] = a["perimetre"] if indices["tests"] else [f"{a['depot']}/tests"]
                elif devs:
                    a["verification"] = " && ".join(f"(cd {shlex.quote(x['depot'])} && {x['verification']})" for x in devs)
                else:
                    a["verification"] = None
                    a_confirmer.append("testeur : commande de vérification à préciser.")
            elif canon == "documentation":
                a["perimetre"] = ["docs", "README.md"]
            elif canon == "ux":
                a["perimetre"] = ["docs/ux"]
            team["agents"].append(a)
        elif canon in ("donnees", "devops"):
            per = indices[canon]
            if not per:
                a_confirmer.append(f"{canon} : aucun dossier détecté, spécialité et périmètre à préciser.")
            team["agents"].append({"nom": canon, "role": ROLES_DEV, "actif": True, "specialite": "<à préciser>", "depot": ".",
                                   "perimetre": per or [canon], "verification": None, "modele": "sonnet"})
        else:
            team["agents"].append(agent_dev_propose(canon, stacks, a_confirmer))
    # Un développeur ajouté après coup doit aussi être couvert par le testeur existant.
    testeur = next((a for a in actifs(team, "testeur") if "testeur" not in demandes), None)
    devs = [x for x in actifs(team, ROLES_DEV) if x.get("verification")]
    if testeur and len(devs) > 1:
        couvert = lambda x: x["depot"] == testeur.get("depot") or f"cd {shlex.quote(x['depot'])} " in (testeur.get("verification") or "")
        if not all(couvert(x) for x in devs):
            testeur["verification"] = " && ".join(f"(cd {shlex.quote(x['depot'])} && {x['verification']})" for x in devs)
            testeur["depot"] = "."
            testeur["perimetre"] = sorted(set(testeur["perimetre"]) | {f"{x['depot']}/tests" for x in devs if x["depot"] != "."})
            a_confirmer.append("testeur : vérification et périmètre étendus aux nouveaux développeurs.")
    if len(actifs(team, ROLES_DEV)) > 1 and not team["projet"].get("contrat"):
        # En multi-dépôts, specs et contrat vont dans le dépôt producteur pour être versionnés.
        back = next((a for a in actifs(team, ROLES_DEV) if a["nom"] == "backend"), None)
        prefixe = back["depot"] + "/" if back and back["depot"] != "." and not toplevel(RACINE) else ""
        team["projet"]["contrat"] = f"{prefixe}docs/api/openapi.yaml"
        team["projet"]["dossier_specs"] = f"{prefixe}docs/specs"
    pbs = valider_composition(team)
    ecrit = False
    if args.ecrire and not bloquants(pbs):
        TEAM_PATH.parent.mkdir(parents=True, exist_ok=True)
        TEAM_PATH.write_text(json.dumps(team, ensure_ascii=False, indent=2) + "\n")
        ecrit = True
    emit({"tableau": tableau_equipe(team), "a_confirmer": a_confirmer, "problemes": pbs, "ecrit": ecrit, "equipe": team})


def diff_texte(ancien, nouveau, nom):
    import difflib
    return "".join(difflib.unified_diff(ancien.splitlines(True), nouveau.splitlines(True), f"{nom} (existant)", f"{nom} (proposé)"))


def cmd_scaffold(args):
    team = charger_equipe()
    pbs = valider_composition(team)
    if bloquants(pbs):
        bloque("COMPOSITION_INVALIDE", "Corriger .equipe/team.json avant de générer.", problemes=pbs)
    crees, intacts, conflits = [], [], []

    def poser(rel, contenu):
        p = RACINE / rel
        if p.exists():
            ancien = p.read_text(errors="replace")
            if ancien == contenu:
                intacts.append(rel)
            elif rel in (args.ecraser or []):
                if not args.essai:
                    p.write_text(contenu)
                crees.append(rel + " (remplacé)")
            else:
                conflits.append({"fichier": rel, "diff": diff_texte(ancien, contenu, rel)})
        else:
            if not args.essai:
                p.parent.mkdir(parents=True, exist_ok=True)
                p.write_text(contenu)
            crees.append(rel)

    for a in actifs(team):
        poser(f".claude/agents/{a['nom']}.md", rendre_agent(team, a))
    dossier = team["projet"].get("dossier_specs", "docs/specs")
    gabarit_spec = (ASSETS / "spec.md").read_text()
    poser(f"{dossier}/_modele-spec.md", gabarit_spec)
    contrat = team["projet"].get("contrat")
    if contrat and not (RACINE / contrat).exists():
        poser(contrat, (ASSETS / "openapi.yaml").read_text().replace("{{NOM_DU_PROJET}}", team["projet"].get("nom", "Projet")))
    elif contrat:
        intacts.append(contrat)

    section = rendre_section_claude(team)
    claude = RACINE / "CLAUDE.md"
    if not claude.exists():
        if not args.essai:
            claude.write_text("# " + team["projet"].get("nom", "Projet") + "\n\n" + section)
        crees.append("CLAUDE.md")
    else:
        txt = claude.read_text(errors="replace")
        if DEBUT_SECTION in txt and FIN_SECTION in txt:
            nouveau = re.sub(re.escape(DEBUT_SECTION) + r".*?" + re.escape(FIN_SECTION) + r"\n?", lambda m: section, txt, flags=re.S)
        else:
            nouveau = txt.rstrip() + "\n\n" + section
        if nouveau == txt:
            intacts.append("CLAUDE.md")
        elif "CLAUDE.md" in (args.ecraser or []):
            if not args.essai:
                claude.write_text(nouveau)
            crees.append("CLAUDE.md (section Équipe d'agents)")
        else:
            conflits.append({"fichier": "CLAUDE.md", "diff": diff_texte(txt, nouveau, "CLAUDE.md")})
    emit({"statut": "essai" if args.essai else "ok", "crees": crees, "intacts": intacts, "a_confirmer": conflits,
          "avertissements": [p for p in pbs if p["gravite"] != "bloquant"],
          "note": "a_confirmer : montrer le diff à l'utilisateur, puis relancer avec --ecraser <fichier> s'il accepte."})


def cmd_preflight(args):
    team = charger_equipe()
    devs = actifs(team, ROLES_DEV)
    pbs = valider_composition(team)
    tops = {}
    for a in devs:
        tops.setdefault(str(toplevel(RACINE / a.get("depot", ".")) or "aucun"), []).append(a["nom"])
    racine_git = toplevel(RACINE)
    if len(devs) <= 1:
        mode, raison = "sequentiel", "Un seul développeur : pas de parallélisme."
    elif "aucun" in tops:
        mode, raison = "sequentiel", "Au moins un développeur hors git : pas d'isolation possible."
    elif all(len(v) == 1 for v in tops.values()) and not racine_git:
        mode, raison = "par-depot", "Un développeur par dépôt : parallèle sans worktree, le dépôt isole."
    elif racine_git:
        mode, raison = "worktree", "Plusieurs développeurs dans un même dépôt : parallèle avec isolation: worktree."
    else:
        mode, raison = "sequentiel", "Plusieurs développeurs dans un dépôt enfant, session hors git : worktree impossible."
    specs = team["projet"].get("dossier_specs", "docs/specs")
    contrat = team["projet"].get("contrat") or ""
    depots = []
    for top_s in tops:
        if top_s == "aucun":
            continue
        top = Path(top_s)
        _, branche = git(top, "branch", "--show-current")
        code, defaut = git(top, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
        defaut = defaut.split("/", 1)[-1] if code == 0 else None
        sales = []
        for f in fichiers_modifies(top):
            rel = relatif_projet(top, f)
            if not (rel.startswith(".claude/") or rel == "CLAUDE.md" or rel.startswith(norm(specs) + "/") or rel == contrat):
                sales.append(rel)
        depots.append({"chemin": os.path.relpath(top, RACINE), "branche": branche,
                       "sur_branche_par_defaut": branche in (defaut, "main", "master"), "modifs_hors_equipe": sales})
        if sales and mode == "worktree":
            pbs.append({"code": "ARBRE_NON_PROPRE", "gravite": "bloquant",
                        "message": f"{len(sales)} fichier(s) non committés dans {top.name} : un worktree part de HEAD et ne les verrait pas. Demander quoi en faire."})
    feature = args.fonctionnalite
    if feature:
        e = charger_etat(feature)
        if e.get("accord") is None:
            pbs.append({"code": "ACCORD_ABSENT", "gravite": "bloquant", "message": "Pas de feu vert enregistré : retour à /equipe cadrer."})
        elif e["accord"]["hash"] != hash_accord(team, feature):
            pbs.append({"code": "SPEC_MODIFIEE_APRES_ACCORD", "gravite": "bloquant", "message": "Spec ou contrat modifiés depuis le feu vert : redemander l'accord."})
    emit({"mode": mode, "raison": raison, "depots": depots, "problemes": pbs,
          "branche_de_travail": f"equipe/{feature}" if feature else None},
         2 if bloquants(pbs) else 0)


def cmd_demarrer(args):
    team = charger_equipe()
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", args.fonctionnalite):
        bloque("NOM_INVALIDE", "Nom de fonctionnalité attendu en minuscules-avec-tirets.")
    if chemin_etat(args.fonctionnalite).exists():
        emit({"statut": "existe", "etat": charger_etat(args.fonctionnalite)})
    etat = {"fonctionnalite": args.fonctionnalite, "phase": "cadrage", "cree": maintenant(), "tours": 0,
            "accord": None, "verifications": {}, "incidents": [], "reference": None,
            "spec": os.path.relpath(chemin_spec(team, args.fonctionnalite), RACINE)}
    sauver_etat(etat)
    emit({"statut": "ok", "etat": etat})


def cmd_approuver(args):
    team = charger_equipe()
    e = charger_etat(args.fonctionnalite)
    spec = chemin_spec(team, args.fonctionnalite)
    if not spec.is_file():
        bloque("SPEC_ABSENTE", f"{spec} n'existe pas.")
    texte = spec.read_text()
    if not re.search(r"\bCA-1\b", texte):
        bloque("CRITERES_ABSENTS", "La spec n'a aucun critère d'acceptation CA-x.")
    contrat = chemin_contrat(team)
    if len(actifs(team, ROLES_DEV)) > 1 and not (contrat and contrat.is_file()):
        bloque("CONTRAT_ABSENT", "Plusieurs développeurs actifs : le contrat doit exister avant le feu vert.")
    if not args.citation.strip():
        bloque("CITATION_VIDE", "Citer les mots de l'utilisateur : le feu vert est le sien.")
    texte2 = re.sub(r"(Statut\s*:\s*)[^\n]*", r"\1validée", texte, count=1)
    if texte2 != texte:
        spec.write_text(texte2)
    e["accord"] = {"citation": args.citation, "date": maintenant(), "hash": hash_accord(team, args.fonctionnalite)}
    if e["phase"] == "cadrage":
        e["phase"] = "valide"
    sauver_etat(e)
    emit({"statut": "ok", "phase": e["phase"], "accord": e["accord"]})


ORDRE = {"developpement": {"valide"}, "integration": {"developpement", "correction"},
         "controles": {"integration"}, "termine": {"controles"}}


def manquantes(team, e, roles):
    emp = empreinte(team)
    res = []
    for a in actifs(team):
        if a.get("role") not in roles or not a.get("verification"):
            continue
        v = e["verifications"].get(a["nom"])
        if v is None:
            res.append({"agent": a["nom"], "raison": "jamais lancée"})
        elif v["code"] != 0:
            res.append({"agent": a["nom"], "raison": f"échec (code {v['code']})"})
        elif v["empreinte"] != emp:
            res.append({"agent": a["nom"], "raison": "périmée : le code a changé depuis"})
    return res


def cmd_avancer(args):
    team = charger_equipe()
    e = charger_etat(args.fonctionnalite)
    cible = args.phase
    if e["phase"] not in ORDRE[cible]:
        bloque("TRANSITION_INTERDITE", f"De « {e['phase']} » vers « {cible} » : interdit. Attendu depuis : {sorted(ORDRE[cible])}.")
    if e.get("accord") is None:
        bloque("ACCORD_ABSENT", "Aucun feu vert enregistré.")
    if e["accord"]["hash"] != hash_accord(team, args.fonctionnalite):
        bloque("SPEC_MODIFIEE_APRES_ACCORD", "Spec ou contrat modifiés depuis le feu vert : représenter le changement et réenregistrer l'accord.")
    if cible == "developpement":
        e["reference"] = instantane(team)
    if cible == "controles":
        m = manquantes(team, e, {ROLES_DEV})
        if m:
            bloque("VERIFICATIONS_INCOMPLETES", "Les vérifications doivent passer sur le résultat intégré.", detail=m)
    if cible == "termine":
        m = manquantes(team, e, {ROLES_DEV, "testeur"})
        if m:
            bloque("VERIFICATIONS_INCOMPLETES", "Relancer `equipe verify --tout` sur l'arbre final.", detail=m)
    e["phase"] = cible
    sauver_etat(e)
    emit({"statut": "ok", "phase": cible})


def cmd_tour(args):
    charger_equipe()
    e = charger_etat(args.fonctionnalite)
    if e["phase"] not in ("integration", "controles"):
        bloque("TRANSITION_INTERDITE", f"Un tour de correction part d'une intégration ou de contrôles, pas de « {e['phase']} ».")
    if e.get("tours", 0) >= MAX_TOURS:
        emit({"statut": "epuise", "code": "TOURS_EPUISES", "tours": e["tours"],
              "message": "3 tours utilisés : s'arrêter et faire le point (equipe arreter, puis /equipe bilan)."}, 3)
    e["tours"] = e.get("tours", 0) + 1
    e["phase"] = "correction"
    sauver_etat(e)
    emit({"statut": "ok", "tour": e["tours"], "restants": MAX_TOURS - e["tours"]})


def cmd_arreter(args):
    e = charger_etat(args.fonctionnalite)
    e["phase"] = "arrete"
    e["raison_arret"] = args.raison
    sauver_etat(e)
    emit({"statut": "ok", "phase": "arrete"})


def cmd_verify(args):
    team = charger_equipe()
    e = charger_etat(args.fonctionnalite)
    if args.agent:
        cibles = [agent_par_nom(team, args.agent)]
    else:
        cibles = [a for a in actifs(team) if a.get("verification")]
    resultats = []
    for a in cibles:
        cmd = a.get("verification")
        if not cmd:
            bloque("VERIFICATION_ABSENTE", f"{a['nom']} n'a pas de commande de vérification.")
        rep = RACINE / a.get("depot", ".")
        try:
            r = subprocess.run(cmd, shell=True, cwd=rep, capture_output=True, text=True, errors="replace", timeout=args.timeout)
            code, sortie = r.returncode, (r.stdout + r.stderr)
        except subprocess.TimeoutExpired:
            code, sortie = 124, f"Délai dépassé ({args.timeout}s)"
        queue = "\n".join(sortie.strip().splitlines()[-30:])
        resultats.append({"agent": a["nom"], "commande": cmd, "code": code, "ok": code == 0, "sortie": queue})
        e["verifications"][a["nom"]] = {"commande": cmd, "code": code, "date": maintenant(), "sortie": queue}
    emp = empreinte(team)
    for r in resultats:
        e["verifications"][r["agent"]]["empreinte"] = emp
    sauver_etat(e)
    emit({"statut": "ok" if all(r["ok"] for r in resultats) else "echec", "resultats": resultats},
         0 if all(r["ok"] for r in resultats) else 2)


def fichiers_du_agent(team, a, args):
    top = toplevel(RACINE / a.get("depot", "."))
    if not top:
        bloque("SANS_GIT", "Contrôle de périmètre impossible hors git.")
    info = {}
    if args.worktree:
        wt = Path(args.worktree)
        _, head_base = git(top, "rev-parse", args.base or "HEAD")
        code, fork = git(wt, "merge-base", "HEAD", head_base)
        if code != 0:
            bloque("BASE_INTROUVABLE", f"Pas d'ancêtre commun entre {wt} et {args.base or 'HEAD'}.")
        if fork != head_base:
            info["base_divergente"] = {"attendue": head_base, "reelle": fork,
                                       "message": "Le worktree ne part pas de la branche de travail : la fusion pourrait défaire ou importer des changements."}
        _, diff = git(wt, "diff", "--name-only", "--no-renames", fork, "HEAD")
        fichiers = set(filter(None, diff.splitlines())) | set(fichiers_modifies(wt))
        return [relatif_projet(top, f) for f in sorted(fichiers)], info, None
    if args.base:
        code, diff = git(top, "diff", "--name-only", "--no-renames", args.base, args.head or "HEAD")
        if code != 0:
            bloque("BASE_INTROUVABLE", f"Référence inconnue : {args.base}.")
        return [relatif_projet(top, f) for f in filter(None, diff.splitlines())], info, None
    if not args.fonctionnalite:
        bloque("USAGE", "Indiquer --fonctionnalite (arbre courant), --worktree ou --base.")
    e = charger_etat(args.fonctionnalite)
    ref = e.get("reference") or {}
    res = []
    actuel = {}
    for t in depots_equipe(team):
        for f in fichiers_modifies(t):
            rel = relatif_projet(t, f)
            actuel[rel] = sha_fichier(t / f)
            if ref.get(rel, "—") != actuel[rel]:
                res.append(rel)
    return sorted(res), info, (e, actuel)


def cmd_scope_check(args):
    team = charger_equipe()
    a = agent_par_nom(team, args.agent)
    fichiers, info, reprise = fichiers_du_agent(team, a, args)
    perimetre = a.get("perimetre", [])
    if a.get("role") == "testeur" or a.get("role") == ROLES_DEV or a.get("role") in ROLES_CONCEPTION:
        hors = [f for f in fichiers if not dans_perimetre(f, perimetre)]
    else:
        hors = list(fichiers)
    contrat = team["projet"].get("contrat")
    dossier = norm(team["projet"].get("dossier_specs", "docs/specs"))
    interdits = [f for f in fichiers if f == contrat or f.startswith(dossier + "/")]
    incident = bool(hors or interdits)
    if reprise:
        e, actuel = reprise
        if incident:
            e["incidents"].append({"agent": a["nom"], "date": maintenant(), "hors_perimetre": hors, "spec_ou_contrat": interdits})
        else:
            e["reference"] = actuel
        sauver_etat(e)
    emit({"agent": a["nom"], "perimetre": perimetre, "fichiers": fichiers, "hors_perimetre": hors,
          "spec_ou_contrat_touches": interdits, **info,
          "statut": "incident" if incident else "ok"}, 2 if incident else 0)


def binaire_present(cmd, rep):
    try:
        mots = shlex.split(cmd)
    except ValueError:
        return True
    for m in mots:
        if "=" in m.split("/")[0]:
            continue
        if m in ("cd",):
            return True
        return bool(shutil.which(m)) or (rep / m).exists()
    return True


def cmd_doctor(args):
    team = charger_equipe(obligatoire=False)
    f = []

    def trouve(id_, gravite, resume, correctif=None):
        f.append({"id": id_, "severite": gravite, "resume": resume, "correctif": correctif})

    if team is None:
        trouve("equipe-absente", "route", "Pas de .equipe/team.json.", "/equipe composer")
        emit({"constats": f})
    for p in valider_composition(team):
        trouve("composition-" + p["code"].lower(), "route" if p["gravite"] == "bloquant" else "mention", p["message"], "/equipe composer")
    agents_dir = RACINE / ".claude" / "agents"
    noms = {a["nom"] for a in actifs(team)}
    for a in actifs(team):
        p = agents_dir / f"{a['nom']}.md"
        if not p.is_file():
            trouve("agent-absent", "auto", f"{a['nom']} : fichier d'agent absent.", "equipe scaffold")
        elif p.read_text(errors="replace") != rendre_agent(team, a):
            trouve("agent-derive", "mention", f"{a['nom']} : le fichier diffère de team.json (retouche manuelle ou config changée).",
                   f"equipe scaffold puis, après accord, --ecraser .claude/agents/{a['nom']}.md")
        rep = RACINE / a.get("depot", ".")
        if not rep.is_dir():
            trouve("depot-absent", "route", f"{a['nom']} : dépôt {a.get('depot')} introuvable.", "/equipe composer")
        elif a.get("verification") and not binaire_present(a["verification"], rep):
            trouve("verification-introuvable", "mention", f"{a['nom']} : `{a['verification']}` ne semble pas exécutable ici.")
        if a.get("role") == ROLES_DEV or a.get("role") == "testeur":
            for per in a.get("perimetre", []):
                base = prefixe_fixe(per)
                if not (RACINE / base).exists():
                    trouve("perimetre-absent", "mention", f"{a['nom']} : {per} n'existe pas encore.")
    if agents_dir.is_dir():
        for p in agents_dir.glob("*.md"):
            if MARQUE_AGENT in p.read_text(errors="replace") and p.stem not in noms:
                trouve("agent-orphelin", "mention", f"{p.name} a été généré par equipe mais l'agent n'est plus actif.", "supprimer après accord")
    contrat = chemin_contrat(team)
    if contrat and not contrat.is_file():
        trouve("contrat-absent", "auto", f"{team['projet']['contrat']} absent.", "equipe scaffold")
    claude = RACINE / "CLAUDE.md"
    section = rendre_section_claude(team)
    if not claude.is_file() or DEBUT_SECTION not in claude.read_text(errors="replace"):
        trouve("claude-section-absente", "route", "CLAUDE.md n'a pas de section Équipe d'agents.", "equipe scaffold --ecraser CLAUDE.md après accord")
    elif section.strip() not in claude.read_text(errors="replace"):
        trouve("claude-section-derive", "mention", "La section Équipe de CLAUDE.md ne correspond plus à team.json.", "equipe scaffold --ecraser CLAUDE.md après accord")
    for r in etats_resumes():
        e = charger_etat(r["fonctionnalite"])
        if e.get("accord") and e["phase"] not in ("termine", "arrete") and e["accord"]["hash"] != hash_accord(team, r["fonctionnalite"]):
            trouve("spec-modifiee-apres-accord", "route", f"{r['fonctionnalite']} : spec ou contrat changés depuis le feu vert.", "/equipe cadrer")
        if e.get("incidents") and e["phase"] not in ("termine", "arrete"):
            trouve("incidents-ouverts", "mention", f"{r['fonctionnalite']} : {len(e['incidents'])} sortie(s) de périmètre enregistrée(s).")
    for top in depots_equipe(team):
        _, liste = git(top, "worktree", "list", "--porcelain")
        n = sum(1 for l in liste.splitlines() if l.startswith("worktree ")) - 1
        if n > 0:
            trouve("worktrees-restants", "mention", f"{top.name} : {n} worktree(s) en plus de l'arbre principal.", "git worktree list, nettoyer après intégration")
    emit({"constats": f})


def cmd_etat(args):
    charger_equipe()
    if args.fonctionnalite:
        emit(charger_etat(args.fonctionnalite))
    emit({"fonctionnalites": etats_resumes()})


def principal():
    p = argparse.ArgumentParser(prog="equipe", description="Faits et garde-fous de la skill equipe.")
    s = p.add_subparsers(dest="commande", required=True)
    s.add_parser("context").set_defaults(fn=cmd_context)
    s.add_parser("catalogue").set_defaults(fn=cmd_catalogue)
    x = s.add_parser("proposer")
    x.add_argument("agents", nargs="+")
    x.add_argument("--ecrire", action="store_true")
    x.set_defaults(fn=cmd_proposer)
    x = s.add_parser("scaffold")
    x.add_argument("--essai", action="store_true")
    x.add_argument("--ecraser", action="append")
    x.set_defaults(fn=cmd_scaffold)
    x = s.add_parser("preflight")
    x.add_argument("fonctionnalite", nargs="?")
    x.set_defaults(fn=cmd_preflight)
    x = s.add_parser("demarrer")
    x.add_argument("fonctionnalite")
    x.set_defaults(fn=cmd_demarrer)
    x = s.add_parser("approuver")
    x.add_argument("fonctionnalite")
    x.add_argument("--citation", required=True)
    x.set_defaults(fn=cmd_approuver)
    x = s.add_parser("avancer")
    x.add_argument("fonctionnalite")
    x.add_argument("phase", choices=sorted(ORDRE))
    x.set_defaults(fn=cmd_avancer)
    x = s.add_parser("tour")
    x.add_argument("fonctionnalite")
    x.set_defaults(fn=cmd_tour)
    x = s.add_parser("arreter")
    x.add_argument("fonctionnalite")
    x.add_argument("--raison", required=True)
    x.set_defaults(fn=cmd_arreter)
    x = s.add_parser("verify")
    x.add_argument("fonctionnalite")
    g = x.add_mutually_exclusive_group(required=True)
    g.add_argument("--agent")
    g.add_argument("--tout", action="store_true")
    x.add_argument("--timeout", type=int, default=900)
    x.set_defaults(fn=cmd_verify)
    x = s.add_parser("scope-check")
    x.add_argument("agent")
    x.add_argument("--fonctionnalite")
    x.add_argument("--worktree")
    x.add_argument("--base")
    x.add_argument("--head")
    x.set_defaults(fn=cmd_scope_check)
    s.add_parser("doctor").set_defaults(fn=cmd_doctor)
    x = s.add_parser("etat")
    x.add_argument("fonctionnalite", nargs="?")
    x.set_defaults(fn=cmd_etat)
    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    principal()
