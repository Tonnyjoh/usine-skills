#!/usr/bin/env python3
"""Tool behind the team skill: establishes facts and enforces the guardrails.

The model decides and coordinates; this script answers what it must not assume
(topology, stacks, scope compliance, real verification results) and refuses
phase transitions whose condition is not met.

Output: JSON on stdout. Exit codes: 0 ok, 2 blocked by a guardrail or bad usage,
3 fix rounds exhausted. Standard library only.
"""
import argparse
import datetime
import fnmatch
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent.parent
ASSETS = SKILL_DIR / "assets"
IGNORED = {"node_modules", "vendor", "target", "build", "dist", ".next", ".nuxt", "venv",
           ".venv", "__pycache__", ".dart_tool", ".gradle", ".idea", ".vscode", "coverage"}
ROLE_DEV = "developer"
DESIGN_ROLES = {"ux", "documentation"}
MAX_ROUNDS = 3
AGENT_MARK = "<!-- Generated by /team compose."
CODEX_MARK = "# Generated by /team compose."
RULE_FILES = ("CLAUDE.md", "AGENTS.md")
SECTION_START = "<!-- team:start -->"
SECTION_END = "<!-- team:end -->"
PURPOSES = {"backend": "the backend", "frontend": "the web interface", "mobile": "the mobile app",
            "data": "the schema, migrations and queries", "devops": "the build and deployment tooling"}
TO_CONFIRM = "(to confirm)"


def emit(obj, code=0):
    print(json.dumps(obj, ensure_ascii=False, indent=2))
    sys.exit(code)


def blocked(code, message, **extra):
    emit({"status": "blocked", "code": code, "message": message, **extra}, 2)


def now():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def sha(data):
    return hashlib.sha256(data).hexdigest()[:16]


def sha_file(path):
    try:
        return sha(Path(path).read_bytes())
    except OSError:
        return None


def git(repo, *args):
    try:
        r = subprocess.run(["git", "-c", "core.quotepath=off", "-C", str(repo), *args],
                           capture_output=True, text=True, errors="replace")
    except (OSError, ValueError):
        return 127, ""
    return r.returncode, r.stdout.strip("\n")


def toplevel(repo):
    code, out = git(repo, "rev-parse", "--show-toplevel")
    return Path(out) if code == 0 and out else None


def find_root():
    cwd = Path.cwd()
    for d in [cwd, *cwd.parents]:
        if (d / ".team" / "team.json").is_file():
            return d
    return cwd


ROOT = find_root()
TEAM_PATH = ROOT / ".team" / "team.json"
FEATURES_DIR = ROOT / ".team" / "features"


# ---------------------------------------------------------------- detection

def read(path):
    try:
        return Path(path).read_text(errors="replace")
    except OSError:
        return ""


def _node(d):
    try:
        pkg = json.loads(read(d / "package.json"))
    except ValueError:
        return None
    deps = {**pkg.get("dependencies", {}), **pkg.get("devDependencies", {})}
    scripts = pkg.get("scripts", {})
    pm = "npm"
    install = "npm install"
    if (d / "pnpm-lock.yaml").exists():
        pm, install = "pnpm", "pnpm install --frozen-lockfile"
    elif (d / "yarn.lock").exists():
        pm, install = "yarn", "yarn install --frozen-lockfile"
    elif (d / "bun.lockb").exists() or (d / "bun.lock").exists():
        pm, install = "bun", "bun install --frozen-lockfile"
    elif (d / "package-lock.json").exists():
        install = "npm ci"
    checks = []
    for name in ("lint", "typecheck", "test"):
        s = scripts.get(name, "")
        if s and "no test specified" not in s:
            checks.append(f"{pm} run {name}")
    check = " && ".join(checks) or None
    specs = [("@nestjs/core", "backend", "Node.js / NestJS"), ("@angular/core", "frontend", "Angular"),
             ("next", "frontend", "Next.js"), ("nuxt", "frontend", "Vue / Nuxt"),
             ("react-native", "mobile", "React Native"), ("expo", "mobile", "React Native"),
             ("vue", "frontend", "Vue / Nuxt"), ("react", "frontend", "React"),
             ("express", "backend", "Node.js / Express")]
    for dep, role, spec in specs:
        if dep in deps:
            return role, spec, check, install
    return "other", f"Node.js {TO_CONFIRM}", check, install


def _java(d):
    pom = d / "pom.xml"
    cmd = "./mvnw -q test" if (d / "mvnw").exists() else "mvn -q test"
    spec = "Java / Spring Boot" if "spring-boot" in read(pom) else f"Java {TO_CONFIRM}"
    return "backend", spec, cmd, None


def _gradle(d):
    txt = read(d / "build.gradle") + read(d / "build.gradle.kts") + read(d / "app" / "build.gradle.kts")
    cmd = "./gradlew test" if (d / "gradlew").exists() else "gradle test"
    if "androidx.compose" in txt or "compose = true" in txt:
        return "mobile", "Kotlin / Jetpack Compose", cmd, None
    if "spring-boot" in txt or "org.springframework.boot" in txt:
        return "backend", "Java / Spring Boot", cmd, None
    if "com.android" in txt:
        return "mobile", f"Android {TO_CONFIRM}", cmd, None
    return "backend", f"JVM {TO_CONFIRM}", cmd, None


def _python(d):
    txt = (read(d / "pyproject.toml") + read(d / "requirements.txt")).lower()
    if "fastapi" in txt:
        spec = "Python / FastAPI"
    elif "django" in txt:
        spec = "Python / Django"
    else:
        spec = f"Python {TO_CONFIRM}"
    install = "pip install -r requirements.txt" if (d / "requirements.txt").exists() else "pip install -e ."
    return "backend", spec, "pytest", install


def _dotnet(d):
    return "backend", ".NET / ASP.NET Core", "dotnet test", "dotnet restore"


DETECTORS = [
    (("package.json",), _node),
    (("pom.xml",), _java),
    (("build.gradle", "build.gradle.kts"), _gradle),
    (("pyproject.toml", "requirements.txt"), _python),
    (("pubspec.yaml",), lambda d: ("mobile", "Flutter", "flutter test", "flutter pub get")),
    (("composer.json",), lambda d: ("backend", "PHP / Laravel" if (d / "artisan").exists() else f"PHP {TO_CONFIRM}",
                                    "php artisan test" if (d / "artisan").exists() else "vendor/bin/phpunit",
                                    "composer install")),
    (("go.mod",), lambda d: ("backend", "Go", "go test ./...", "go mod download")),
    (("Package.swift",), lambda d: ("mobile", "Swift / SwiftUI", "swift test", None)),
]


def detect_dir(d):
    for manifests, fn in DETECTORS:
        if any((d / m).exists() for m in manifests):
            return fn(d)
    try:
        if any(p.suffix in (".csproj", ".sln") for p in d.iterdir()):
            return _dotnet(d)
    except OSError:
        pass
    return None


def subdirs(root, depth):
    stack = [(root, 0)]
    while stack:
        d, n = stack.pop()
        yield d
        if n >= depth:
            continue
        try:
            children = sorted(p for p in d.iterdir() if p.is_dir())
        except OSError:
            continue
        for c in children:
            if c.name.startswith(".") or c.name in IGNORED:
                continue
            stack.append((c, n + 1))


def extra_hints(root, stacks):
    hints = {"data": [], "devops": [], "tests": []}
    for d in subdirs(root, 2):
        rel = os.path.relpath(d, root)
        if d.name in ("migrations", "prisma", "alembic") or rel.endswith("resources/db"):
            hints["data"].append(rel)
        if d.name in ("test", "tests", "__tests__", "e2e", "spec", "integration_test"):
            hints["tests"].append(rel)
    if (root / ".github" / "workflows").is_dir():
        hints["devops"].append(".github")
    if (root / ".gitlab-ci.yml").exists():
        hints["devops"].append(".gitlab-ci.yml")
    for name in ("Dockerfile", "compose.yaml", "docker-compose.yml"):
        if (root / name).exists():
            hints["devops"].append(name)
    for s in stacks:
        t = root / s["path"] / "src" / "test"
        if t.is_dir():
            hints["tests"].append(os.path.relpath(t, root))
    hints["tests"] = sorted(set(hints["tests"]))
    return hints


def child_repos(root, depth=2):
    res = []
    for d in subdirs(root, depth):
        if d != root and (d / ".git").exists():
            res.append(d)
    return res


def recent_repos(root):
    found = []
    for d in subdirs(root, 3):
        if (d / ".git").exists():
            code, out = git(d, "log", "-1", "--format=%ct %cs")
            if code == 0 and out:
                ts, date = out.split(" ", 1)
                found.append((int(ts), os.path.relpath(d, root), date))
    found.sort(reverse=True)
    return [{"path": p, "last_commit": dt} for _, p, dt in found[:8]]


def detect_topology(root):
    if toplevel(root):
        return "single-repo"
    return "multi-repo" if child_repos(root) else "no-git"


def detect_stacks(root):
    stacks = []
    for d in subdirs(root, 2):
        det = detect_dir(d)
        if det:
            role, spec, check, install = det
            stacks.append({"path": os.path.relpath(d, root), "suggested_role": role, "suggested_specialty": spec,
                           "suggested_verification": check, "suggested_install": install})
    stacks.sort(key=lambda s: s["path"])
    return stacks


# ---------------------------------------------------------------- team

def load_team(required=True):
    if not TEAM_PATH.is_file():
        if required:
            blocked("NO_TEAM", "No .team/team.json here: run /team add or /team compose from the project root.")
        return None
    try:
        return json.loads(TEAM_PATH.read_text())
    except ValueError as e:
        blocked("INVALID_TEAM", f".team/team.json is not valid JSON: {e}")


def active(team, role=None):
    res = [a for a in team.get("agents", []) if a.get("active", True)]
    return [a for a in res if a.get("role") == role] if role else res


def agent_by_name(team, name):
    for a in team.get("agents", []):
        if a.get("name") == name:
            return a
    blocked("UNKNOWN_AGENT", f"Agent '{name}' is not in .team/team.json.")


def norm(path):
    return path.strip().strip("/").removeprefix("./") or "."


def fixed_prefix(pattern):
    m = norm(pattern)
    pos = min((m.find(c) for c in "*?[" if c in m), default=-1)
    return m if pos < 0 else m[:pos].rsplit("/", 1)[0] if "/" in m[:pos] else "."


def in_scope(file, scope):
    for p in scope:
        p = norm(p)
        if p == ".":
            return True
        if any(c in p for c in "*?["):
            if fnmatch.fnmatch(file, p):
                return True
        elif file == p or file.startswith(p + "/"):
            return True
    return False


def overlaps(devs):
    res = []
    for i, a in enumerate(devs):
        for b in devs[i + 1:]:
            for pa in a.get("scope", []):
                for pb in b.get("scope", []):
                    x, y = fixed_prefix(pa), fixed_prefix(pb)
                    if x == "." or y == "." or x == y or x.startswith(y + "/") or y.startswith(x + "/"):
                        res.append({"agents": [a["name"], b["name"]], "paths": [pa, pb]})
    return res


def validate_composition(team):
    pb = []
    devs = active(team, ROLE_DEV)
    if not devs:
        pb.append({"code": "NO_DEVELOPER", "severity": "blocking",
                   "message": "No active developer: ask the user what to do."})
    if len(devs) > 1:
        for c in overlaps(devs):
            pb.append({"code": "OVERLAPPING_SCOPES", "severity": "blocking",
                       "message": f"{c['agents'][0]} and {c['agents'][1]} overlap: {c['paths'][0]} / {c['paths'][1]}."})
        if not team.get("project", {}).get("contract"):
            pb.append({"code": "CONTRACT_REQUIRED", "severity": "blocking",
                       "message": "Several active developers: an API or interface contract is mandatory."})
    if len(active(team)) > 4:
        pb.append({"code": "HIGH_COST", "severity": "warning",
                   "message": f"{len(active(team))} active agents: warn about token cost and offer a smaller version."})
    for a in active(team):
        for field in ("name", "role", "specialty", "scope"):
            if a.get(field) in (None, "") or "<" in str(a.get(field, "")):
                pb.append({"code": "INCOMPLETE_FIELD", "severity": "blocking",
                           "message": f"Agent {a.get('name', '?')}: field '{field}' is empty or still between <...>."})
        if a.get("role") in (ROLE_DEV, "tester") and not a.get("verification"):
            pb.append({"code": "NO_VERIFICATION", "severity": "blocking",
                       "message": f"Agent {a.get('name')}: verification command missing."})
    return pb


def blocking(pbs):
    return [p for p in pbs if p["severity"] == "blocking"]


def instructions_for(agent):
    if agent.get("instructions"):
        return agent["instructions"]
    cat = json.loads((ASSETS / "catalog.json").read_text())
    spec = agent.get("specialty", "").lower()
    for family in cat.values():
        for name, text in family.items():
            if name.lower() == spec:
                return text
    return "Specialty not in the catalog: explore the repository and follow its actual conventions."


def render_agent(team, a):
    role = a["role"]
    scope = ", ".join(a.get("scope", [])) or "none (read-only)"
    v = {"NAME": a["name"], "SPECIALTY": a["specialty"], "SCOPE": scope, "MODEL": a.get("model", "sonnet"),
         "VERIFY_COMMAND": a.get("verification") or "none", "INSTALL": a.get("install") or "none"}
    if role == ROLE_DEV:
        template = "developer.md"
        v["PURPOSE"] = a.get("purpose") or PURPOSES.get(a["name"].split("-")[0], f"the {a['name']} part")
        v["INSTRUCTIONS"] = instructions_for(a)
    elif role == "tester":
        template = "tester.md"
    elif role in ("reviewer", "security"):
        template = "read-only.md"
        rev = role == "reviewer"
        v["DESCRIPTION_TITLE"] = "Code reviewer" if rev else "Security review"
        v["ROLE_TITLE"] = "reviewer" if rev else "security specialist"
        v["FOCUS"] = ("Logic errors, missed edge cases, duplication, readability, architecture compliance, missing tests."
                      if rev else "Injection, access control and permissions, secrets handling, input validation, sensitive data in logs, vulnerable dependencies, CORS and header configuration.")
    elif role in DESIGN_ROLES:
        template = "design.md"
        ux = role == "ux"
        v["DESCRIPTION_TITLE"] = "UX" if ux else "Documentation"
        v["ROLE_TITLE"] = "ux" if ux else "documentation"
        v["FOCUS"] = ("Describe user journeys, interface states (loading, empty, error, access denied), accessibility and copy, based on the spec. Propose; do not decide for the user."
                      if ux else "Document what actually exists (read the code and the spec); never invent behavior or commands.")
    else:
        blocked("UNKNOWN_ROLE", f"Agent {a['name']}: unknown role '{role}'.")
    text = (ASSETS / "agents" / template).read_text()
    for k, val in v.items():
        text = text.replace("{{" + k + "}}", val)
    return text


def render_codex_agent(team, a):
    """Same agent in Codex format. The model is inherited: `sonnet` means nothing there."""
    m = re.match(r"---\n(.*?)\n---\n(.*)", render_agent(team, a), re.S)
    description = re.search(r"^description: (.*)$", m.group(1), re.M).group(1)
    body = re.sub(r"<!--.*?-->\n*", "", m.group(2), count=1).strip()
    instructions = json.dumps(body, ensure_ascii=False) if "'''" in body else f"'''\n{body}\n'''"
    model = f"model = {json.dumps(a['codex_model'])}\n" if a.get("codex_model") else ""
    return (f"{CODEX_MARK} You may edit this file; /team doctor reports the difference without overwriting it.\n"
            f"name = {json.dumps(a['name'], ensure_ascii=False)}\n"
            f"description = {json.dumps(description, ensure_ascii=False)}\n{model}"
            f"developer_instructions = {instructions}\n")


def agent_files(team, a):
    """An agent's files, one per tool declared in project.tools."""
    tools = project_tools(team)
    res = []
    if "claude" in tools:
        res.append((f".claude/agents/{a['name']}.md", render_agent(team, a)))
    if "codex" in tools:
        res.append((f".codex/agents/{a['name']}.toml", render_codex_agent(team, a)))
    return res


def project_tools(team):
    return team.get("project", {}).get("tools", ["claude"])


def rule_files(team):
    """AGENTS.md carries the same rules for other tools, which do not read CLAUDE.md."""
    tools = project_tools(team)
    return [name for name, needed in (("CLAUDE.md", "claude" in tools), ("AGENTS.md", tools != ["claude"])) if needed]


def team_table(team):
    lines = ["| Agent | Specialty | Scope | Verification | Model |", "|---|---|---|---|---|"]
    for a in active(team):
        lines.append(f"| {a['name']} | {a['specialty']} | {', '.join(a.get('scope', [])) or 'read-only'} "
                     f"| `{a.get('verification') or '-'}` | {a.get('model', 'sonnet')} |")
    return "\n".join(lines)


def render_rules_section(team):
    t = (ASSETS / "rules-section.md").read_text().replace("{{TABLE}}", team_table(team))
    return f"{SECTION_START}\n{t.strip()}\n{SECTION_END}\n"


def spec_path(team, feature):
    return ROOT / team["project"].get("specs_dir", "docs/specs") / f"{feature}.md"


def contract_path(team):
    c = team["project"].get("contract")
    return ROOT / c if c else None


def team_repos(team):
    tops = {}
    for a in active(team):
        top = toplevel(ROOT / a.get("repo", "."))
        if top:
            tops[str(top)] = top
    if not tops:
        for d in child_repos(ROOT):
            tops[str(d)] = d
    return list(tops.values())


# ---------------------------------------------------------------- fingerprints

def changed_files(top):
    r = subprocess.run(["git", "-C", str(top), "status", "--porcelain", "-z", "-uall", "--no-renames"],
                       capture_output=True, text=True, errors="replace")
    if r.returncode != 0:
        return []
    res = []
    for e in r.stdout.split("\0"):
        if len(e) > 3:
            res.append(e[3:])
    return [f for f in res if not f.startswith(".team/") and "/.team/" not in f]


def fingerprint(team):
    h = hashlib.sha256()
    for top in sorted(team_repos(team), key=str):
        _, head = git(top, "rev-parse", "HEAD")
        h.update(head.encode())
        for f in sorted(changed_files(top)):
            h.update(f.encode())
            h.update((sha_file(top / f) or "missing").encode())
    return h.hexdigest()[:16]


def approval_hash(team, feature):
    contract = contract_path(team)
    return {"spec": sha_file(spec_path(team, feature)), "contract": sha_file(contract) if contract else None}


def state_path(feature):
    return FEATURES_DIR / f"{feature}.json"


def load_state(feature):
    p = state_path(feature)
    if not p.is_file():
        blocked("UNKNOWN_FEATURE", f"No state for '{feature}': run `team start {feature}`.")
    return json.loads(p.read_text())


def save_state(state):
    FEATURES_DIR.mkdir(parents=True, exist_ok=True)
    state["updated"] = now()
    state_path(state["feature"]).write_text(json.dumps(state, ensure_ascii=False, indent=2) + "\n")


def project_relative(top, file):
    return os.path.relpath(top / file, ROOT)


def snapshot(team):
    res = {}
    for top in team_repos(team):
        for f in changed_files(top):
            res[project_relative(top, f)] = sha_file(top / f)
    return res


# ---------------------------------------------------------------- commands

def cmd_context(args):
    team = load_team(required=False)
    at_home = ROOT.resolve() == Path.home().resolve()
    directives = []
    res = {"root": str(ROOT), "topology": None, "stacks": [], "hints": {}, "repos": []}
    if at_home:
        directives.append({"code": "NOT_A_PROJECT", "message": "Home folder: create nothing here. Ask which project, then work there with absolute paths or have the session restarted at its root."})
        res["recent_repos"] = recent_repos(ROOT)
        res["directives"] = directives
        emit(res)
    topo = detect_topology(ROOT)
    stacks = detect_stacks(ROOT)
    res.update(topology=topo, stacks=stacks, hints=extra_hints(ROOT, stacks))
    if topo == "single-repo":
        top = toplevel(ROOT)
        _, branch = git(top, "branch", "--show-current")
        res["repos"] = [{"path": os.path.relpath(top, ROOT), "branch": branch, "changes": len(changed_files(top))}]
        if top.resolve() != ROOT.resolve():
            directives.append({"code": "SUBFOLDER", "message": f"The git root is {top}: check that the project really is this subfolder."})
    elif topo == "multi-repo":
        for d in child_repos(ROOT):
            _, branch = git(d, "branch", "--show-current")
            res["repos"].append({"path": os.path.relpath(d, ROOT), "branch": branch, "changes": len(changed_files(d))})
        directives.append({"code": "MULTI_REPO", "message": "Several repositories under a root without git: no worktrees, each repository isolates its developer. Put specs and contract in the producing repository so they are versioned."})
    else:
        directives.append({"code": "NO_GIT", "message": "No git: no worktrees, no scope check, no verification fingerprint. Offer git init (with consent) or work sequentially."})
    if not stacks:
        directives.append({"code": "NO_STACK", "message": "No known manifest: empty project or outside the catalog, explore and ask."})
    if team is None:
        directives.append({"code": "NO_TEAM", "message": "No team yet: /team add or /team compose."})
    else:
        res["team"] = [{"name": a["name"], "role": a.get("role"), "specialty": a.get("specialty")} for a in active(team)]
        res["composition_problems"] = validate_composition(team)
        for a in active(team):
            for rel, _ in agent_files(team, a):
                if not (ROOT / rel).is_file():
                    directives.append({"code": "AGENT_NOT_GENERATED", "message": f"{rel} is missing: team scaffold."})
        res["features"] = state_summaries()
    res["directives"] = directives
    emit(res)


def state_summaries():
    res = []
    if FEATURES_DIR.is_dir():
        for p in sorted(FEATURES_DIR.glob("*.json")):
            e = json.loads(p.read_text())
            res.append({"feature": e["feature"], "phase": e["phase"], "rounds": e.get("rounds", 0), "updated": e.get("updated")})
    return res


def cmd_catalog(args):
    emit(json.loads((ASSETS / "catalog.json").read_text()))


ALIASES = {"front": "frontend", "frontend": "frontend", "web": "frontend", "back": "backend", "backend": "backend", "api": "backend",
           "mobile": "mobile", "data": "data", "database": "data", "db": "data", "devops": "devops",
           "test": "tester", "tests": "tester", "tester": "tester", "review": "reviewer", "reviewer": "reviewer",
           "security": "security", "sec": "security", "ux": "ux", "doc": "documentation", "docs": "documentation", "documentation": "documentation"}
ROLE_DEFAULTS = {"tester": "acceptance and contract tests", "reviewer": "general code review",
                 "security": "application security review", "ux": "user journeys, interface states, accessibility",
                 "documentation": "technical documentation and README"}


def propose_dev(canon, stacks, to_confirm):
    candidates = [s for s in stacks if s["suggested_role"] == canon]
    if not candidates and canon == "backend":
        candidates = [s for s in stacks if s["suggested_role"] == "other"]
    if not candidates:
        to_confirm.append(f"{canon}: no stack detected, specify specialty, folder and verification.")
        return {"name": canon, "role": ROLE_DEV, "active": True, "specialty": "<to confirm>", "repo": ".",
                "scope": [canon], "verification": None, "model": "sonnet"}
    s = candidates[0]
    if len(candidates) > 1:
        to_confirm.append(f"{canon}: several possible folders ({', '.join(c['path'] for c in candidates)}), {s['path']} chosen.")
    if TO_CONFIRM in s["suggested_specialty"]:
        to_confirm.append(f"{canon}: specialty to confirm ({s['path']}).")
    if not s["suggested_verification"]:
        to_confirm.append(f"{canon}: no verification command found in {s['path']}.")
    return {"name": canon, "role": ROLE_DEV, "active": True, "specialty": s["suggested_specialty"], "repo": s["path"],
            "scope": [s["path"]], "install": s["suggested_install"],
            "verification": s["suggested_verification"], "model": "sonnet"}


def cmd_propose(args):
    team = load_team(required=False) or {
        "version": 1, "agents": [],
        "project": {"name": ROOT.name, "goal": "", "specs_dir": "docs/specs", "contract": None, "tools": ["claude"]}}
    stacks = detect_stacks(ROOT)
    hints = extra_hints(ROOT, stacks)
    to_confirm = []
    unknown = [d for d in args.agents if d.lower() not in ALIASES]
    if unknown:
        blocked("UNKNOWN_ROLE", f"Unknown: {', '.join(unknown)}. Known: {', '.join(sorted(set(ALIASES.values())))}.")
    requested = list(dict.fromkeys(ALIASES[d.lower()] for d in args.agents))
    # Developers first: the tester's verification is derived from theirs.
    requested.sort(key=lambda c: c in ROLE_DEFAULTS)
    for canon in requested:
        existing = next((a for a in team["agents"] if a["name"] == canon), None)
        if existing:
            existing["active"] = True
        elif canon in ROLE_DEFAULTS:
            a = {"name": canon, "role": canon, "active": True, "specialty": ROLE_DEFAULTS[canon], "repo": ".", "scope": [], "model": "sonnet"}
            if canon == "tester":
                a["scope"] = hints["tests"]
                if not a["scope"]:
                    a["scope"] = ["tests"]
                    to_confirm.append("tester: no test folder detected, 'tests' proposed.")
                devs = [x for x in active(team, ROLE_DEV) if x.get("verification")]
                if len(devs) == 1:
                    a["repo"], a["verification"] = devs[0]["repo"], devs[0]["verification"]
                    if a["repo"] != ".":
                        a["scope"] = a["scope"] if hints["tests"] else [f"{a['repo']}/tests"]
                elif devs:
                    a["verification"] = " && ".join(f"(cd {shlex.quote(x['repo'])} && {x['verification']})" for x in devs)
                else:
                    a["verification"] = None
                    to_confirm.append("tester: verification command to specify.")
            elif canon == "documentation":
                a["scope"] = ["docs", "README.md"]
            elif canon == "ux":
                a["scope"] = ["docs/ux"]
            team["agents"].append(a)
        elif canon in ("data", "devops"):
            found = hints[canon]
            if not found:
                to_confirm.append(f"{canon}: no folder detected, specialty and scope to specify.")
            team["agents"].append({"name": canon, "role": ROLE_DEV, "active": True, "specialty": "<to confirm>", "repo": ".",
                                   "scope": found or [canon], "verification": None, "model": "sonnet"})
        else:
            team["agents"].append(propose_dev(canon, stacks, to_confirm))
    # A developer added later must also be covered by the existing tester.
    tester = next((a for a in active(team, "tester") if "tester" not in requested), None)
    devs = [x for x in active(team, ROLE_DEV) if x.get("verification")]
    if tester and len(devs) > 1:
        covered = lambda x: x["repo"] == tester.get("repo") or f"cd {shlex.quote(x['repo'])} " in (tester.get("verification") or "")
        if not all(covered(x) for x in devs):
            tester["verification"] = " && ".join(f"(cd {shlex.quote(x['repo'])} && {x['verification']})" for x in devs)
            tester["repo"] = "."
            tester["scope"] = sorted(set(tester["scope"]) | {f"{x['repo']}/tests" for x in devs if x["repo"] != "."})
            to_confirm.append("tester: verification and scope extended to the new developers.")
    if len(active(team, ROLE_DEV)) > 1 and not team["project"].get("contract"):
        # In multi-repo projects, specs and contract go in the producing repository so they are versioned.
        back = next((a for a in active(team, ROLE_DEV) if a["name"] == "backend"), None)
        prefix = back["repo"] + "/" if back and back["repo"] != "." and not toplevel(ROOT) else ""
        team["project"]["contract"] = f"{prefix}docs/api/openapi.yaml"
        team["project"]["specs_dir"] = f"{prefix}docs/specs"
    pbs = validate_composition(team)
    written = False
    if args.write and not blocking(pbs):
        TEAM_PATH.parent.mkdir(parents=True, exist_ok=True)
        TEAM_PATH.write_text(json.dumps(team, ensure_ascii=False, indent=2) + "\n")
        written = True
    emit({"table": team_table(team), "to_confirm": to_confirm, "problems": pbs, "written": written, "team": team})


def text_diff(old, new, name):
    import difflib
    return "".join(difflib.unified_diff(old.splitlines(True), new.splitlines(True), f"{name} (existing)", f"{name} (proposed)"))


def cmd_scaffold(args):
    team = load_team()
    pbs = validate_composition(team)
    if blocking(pbs):
        blocked("INVALID_COMPOSITION", "Fix .team/team.json before generating.", problems=pbs)
    created, untouched, conflicts = [], [], []

    def place(rel, content):
        p = ROOT / rel
        if p.exists():
            old = p.read_text(errors="replace")
            if old == content:
                untouched.append(rel)
            elif rel in (args.overwrite or []):
                if not args.dry_run:
                    p.write_text(content)
                created.append(rel + " (replaced)")
            else:
                conflicts.append({"file": rel, "diff": text_diff(old, content, rel)})
        else:
            if not args.dry_run:
                p.parent.mkdir(parents=True, exist_ok=True)
                p.write_text(content)
            created.append(rel)

    for a in active(team):
        for rel, content in agent_files(team, a):
            place(rel, content)
    specs_dir = team["project"].get("specs_dir", "docs/specs")
    place(f"{specs_dir}/_spec-template.md", (ASSETS / "spec.md").read_text())
    contract = team["project"].get("contract")
    if contract and not (ROOT / contract).exists():
        place(contract, (ASSETS / "openapi.yaml").read_text().replace("{{PROJECT_NAME}}", team["project"].get("name", "Project")))
    elif contract:
        untouched.append(contract)

    section = render_rules_section(team)
    for name in rule_files(team):
        target = ROOT / name
        if not target.exists():
            if not args.dry_run:
                target.write_text("# " + team["project"].get("name", "Project") + "\n\n" + section)
            created.append(name)
            continue
        txt = target.read_text(errors="replace")
        if SECTION_START in txt and SECTION_END in txt:
            new = re.sub(re.escape(SECTION_START) + r".*?" + re.escape(SECTION_END) + r"\n?", lambda m: section, txt, flags=re.S)
        else:
            new = txt.rstrip() + "\n\n" + section
        if new == txt:
            untouched.append(name)
        elif name in (args.overwrite or []):
            if not args.dry_run:
                target.write_text(new)
            created.append(f"{name} (Agent team section)")
        else:
            conflicts.append({"file": name, "diff": text_diff(txt, new, name)})
    emit({"status": "dry-run" if args.dry_run else "ok", "created": created, "untouched": untouched, "to_confirm": conflicts,
          "warnings": [p for p in pbs if p["severity"] != "blocking"],
          "note": "to_confirm: show the diff to the user, then rerun with --overwrite <file> if they accept."})


def cmd_preflight(args):
    team = load_team()
    devs = active(team, ROLE_DEV)
    pbs = validate_composition(team)
    tops = {}
    for a in devs:
        tops.setdefault(str(toplevel(ROOT / a.get("repo", ".")) or "none"), []).append(a["name"])
    root_git = toplevel(ROOT)
    if len(devs) <= 1:
        mode, reason = "sequential", "One developer: no parallelism."
    elif "none" in tops:
        mode, reason = "sequential", "At least one developer outside git: isolation is impossible."
    elif all(len(v) == 1 for v in tops.values()) and not root_git:
        mode, reason = "per-repo", "One developer per repository: parallel without worktrees, the repository isolates."
    elif root_git:
        mode, reason = "worktree", "Several developers in one repository: parallel, each in a worktree."
    else:
        mode, reason = "sequential", "Several developers in a child repository, session outside git: worktrees are impossible."
    specs = team["project"].get("specs_dir", "docs/specs")
    contract = team["project"].get("contract") or ""
    repos = []
    for top_s in tops:
        if top_s == "none":
            continue
        top = Path(top_s)
        _, branch = git(top, "branch", "--show-current")
        code, default = git(top, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
        default = default.split("/", 1)[-1] if code == 0 else None
        dirty = []
        for f in changed_files(top):
            rel = project_relative(top, f)
            if not (rel.startswith((".claude/", ".codex/")) or rel in RULE_FILES or rel.startswith(norm(specs) + "/") or rel == contract):
                dirty.append(rel)
        repos.append({"path": os.path.relpath(top, ROOT), "branch": branch,
                      "on_default_branch": branch in (default, "main", "master"), "changes_outside_team": dirty})
        if dirty and mode == "worktree":
            pbs.append({"code": "DIRTY_TREE", "severity": "blocking",
                        "message": f"{len(dirty)} uncommitted file(s) in {top.name}: a worktree starts from HEAD and would not see them. Ask what to do with them."})
    feature = args.feature
    if feature:
        e = load_state(feature)
        if e.get("approval") is None:
            pbs.append({"code": "NO_APPROVAL", "severity": "blocking", "message": "No go-ahead recorded: back to /team plan."})
        elif e["approval"]["hash"] != approval_hash(team, feature):
            pbs.append({"code": "SPEC_CHANGED_AFTER_APPROVAL", "severity": "blocking", "message": "Spec or contract changed since the go-ahead: ask for approval again."})
    emit({"mode": mode, "reason": reason, "repos": repos, "problems": pbs}, 2 if blocking(pbs) else 0)


def cmd_start(args):
    team = load_team()
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", args.feature):
        blocked("INVALID_NAME", "Feature name expected in lowercase-with-hyphens.")
    if state_path(args.feature).exists():
        emit({"status": "exists", "state": load_state(args.feature)})
    state = {"feature": args.feature, "phase": "planning", "created": now(), "rounds": 0,
             "approval": None, "verifications": {}, "incidents": [], "baseline": None,
             "spec": os.path.relpath(spec_path(team, args.feature), ROOT)}
    save_state(state)
    emit({"status": "ok", "state": state})


def cmd_approve(args):
    team = load_team()
    e = load_state(args.feature)
    spec = spec_path(team, args.feature)
    if not spec.is_file():
        blocked("NO_SPEC", f"{spec} does not exist.")
    text = spec.read_text()
    if not re.search(r"\bAC-1\b", text):
        blocked("NO_CRITERIA", "The spec has no AC-x acceptance criterion.")
    contract = contract_path(team)
    if len(active(team, ROLE_DEV)) > 1 and not (contract and contract.is_file()):
        blocked("NO_CONTRACT", "Several active developers: the contract must exist before the go-ahead.")
    if not args.quote.strip():
        blocked("EMPTY_QUOTE", "Quote the user's words: the go-ahead is theirs.")
    text2 = re.sub(r"(Status\s*:\s*)[^\n]*", r"\1approved", text, count=1)
    if text2 != text:
        spec.write_text(text2)
    e["approval"] = {"quote": args.quote, "date": now(), "hash": approval_hash(team, args.feature)}
    if e["phase"] == "planning":
        e["phase"] = "approved"
    save_state(e)
    emit({"status": "ok", "phase": e["phase"], "approval": e["approval"]})


ORDER = {"development": {"approved"}, "integration": {"development", "fix"},
         "review": {"integration"}, "done": {"review"}}


def missing_verifications(team, e, roles):
    fp = fingerprint(team)
    res = []
    for a in active(team):
        if a.get("role") not in roles or not a.get("verification"):
            continue
        v = e["verifications"].get(a["name"])
        if v is None:
            res.append({"agent": a["name"], "reason": "never run"})
        elif v["code"] != 0:
            res.append({"agent": a["name"], "reason": f"failed (code {v['code']})"})
        elif v["fingerprint"] != fp:
            res.append({"agent": a["name"], "reason": "stale: the code changed since"})
    return res


def cmd_advance(args):
    team = load_team()
    e = load_state(args.feature)
    target = args.phase
    if e["phase"] not in ORDER[target]:
        blocked("FORBIDDEN_TRANSITION", f"From '{e['phase']}' to '{target}' is forbidden. Expected from: {sorted(ORDER[target])}.")
    if e.get("approval") is None:
        blocked("NO_APPROVAL", "No go-ahead recorded.")
    if e["approval"]["hash"] != approval_hash(team, args.feature):
        blocked("SPEC_CHANGED_AFTER_APPROVAL", "Spec or contract changed since the go-ahead: present the change and record the approval again.")
    if target == "development":
        e["baseline"] = snapshot(team)
    if target == "review":
        m = missing_verifications(team, e, {ROLE_DEV})
        if m:
            blocked("INCOMPLETE_VERIFICATIONS", "Verifications must pass on the integrated result.", detail=m)
    if target == "done":
        m = missing_verifications(team, e, {ROLE_DEV, "tester"})
        if m:
            blocked("INCOMPLETE_VERIFICATIONS", "Rerun `team verify --all` on the final tree.", detail=m)
    e["phase"] = target
    save_state(e)
    emit({"status": "ok", "phase": target})


def cmd_round(args):
    load_team()
    e = load_state(args.feature)
    if e["phase"] not in ("integration", "review"):
        blocked("FORBIDDEN_TRANSITION", f"A fix round starts from integration or review, not from '{e['phase']}'.")
    if e.get("rounds", 0) >= MAX_ROUNDS:
        emit({"status": "exhausted", "code": "ROUNDS_EXHAUSTED", "rounds": e["rounds"],
              "message": "3 rounds used: stop and take stock (team stop, then /team report)."}, 3)
    e["rounds"] = e.get("rounds", 0) + 1
    e["phase"] = "fix"
    save_state(e)
    emit({"status": "ok", "round": e["rounds"], "remaining": MAX_ROUNDS - e["rounds"]})


def cmd_stop(args):
    e = load_state(args.feature)
    e["phase"] = "stopped"
    e["stop_reason"] = args.reason
    save_state(e)
    emit({"status": "ok", "phase": "stopped"})


def cmd_verify(args):
    team = load_team()
    e = load_state(args.feature)
    if args.agent:
        targets = [agent_by_name(team, args.agent)]
    else:
        targets = [a for a in active(team) if a.get("verification")]
    results = []
    for a in targets:
        cmd = a.get("verification")
        if not cmd:
            blocked("NO_VERIFICATION", f"{a['name']} has no verification command.")
        cwd = ROOT / a.get("repo", ".")
        try:
            r = subprocess.run(cmd, shell=True, cwd=cwd, capture_output=True, text=True, errors="replace", timeout=args.timeout)
            code, output = r.returncode, (r.stdout + r.stderr)
        except subprocess.TimeoutExpired:
            code, output = 124, f"Timed out ({args.timeout}s)"
        tail = "\n".join(output.strip().splitlines()[-30:])
        results.append({"agent": a["name"], "command": cmd, "code": code, "ok": code == 0, "output": tail})
        e["verifications"][a["name"]] = {"command": cmd, "code": code, "date": now(), "output": tail}
    fp = fingerprint(team)
    for r in results:
        e["verifications"][r["agent"]]["fingerprint"] = fp
    save_state(e)
    emit({"status": "ok" if all(r["ok"] for r in results) else "failed", "results": results},
         0 if all(r["ok"] for r in results) else 2)


def files_of_agent(team, a, args):
    top = toplevel(ROOT / a.get("repo", "."))
    if not top:
        blocked("NO_GIT", "Scope check is impossible outside git.")
    info = {}
    if args.worktree:
        wt = Path(args.worktree)
        _, head_base = git(top, "rev-parse", args.base or "HEAD")
        code, fork = git(wt, "merge-base", "HEAD", head_base)
        if code != 0:
            blocked("BASE_NOT_FOUND", f"No common ancestor between {wt} and {args.base or 'HEAD'}.")
        if fork != head_base:
            info["diverged_base"] = {"expected": head_base, "actual": fork,
                                     "message": "The worktree does not start from the current branch: integrating it could undo or import changes."}
        _, diff = git(wt, "diff", "--name-only", "--no-renames", fork, "HEAD")
        files = set(filter(None, diff.splitlines())) | set(changed_files(wt))
        return [project_relative(top, f) for f in sorted(files)], info, None
    if args.base:
        code, diff = git(top, "diff", "--name-only", "--no-renames", args.base, args.head or "HEAD")
        if code != 0:
            blocked("BASE_NOT_FOUND", f"Unknown reference: {args.base}.")
        return [project_relative(top, f) for f in filter(None, diff.splitlines())], info, None
    if not args.feature:
        blocked("USAGE", "Pass --feature (current tree), --worktree or --base.")
    e = load_state(args.feature)
    ref = e.get("baseline") or {}
    res = []
    current = {}
    for t in team_repos(team):
        for f in changed_files(t):
            rel = project_relative(t, f)
            current[rel] = sha_file(t / f)
            if ref.get(rel, "-") != current[rel]:
                res.append(rel)
    return sorted(res), info, (e, current)


def analyze_scope(team, a, files):
    if a.get("role") == "tester" or a.get("role") == ROLE_DEV or a.get("role") in DESIGN_ROLES:
        outside = [f for f in files if not in_scope(f, a.get("scope", []))]
    else:
        outside = list(files)
    contract = team["project"].get("contract")
    specs_dir = norm(team["project"].get("specs_dir", "docs/specs"))
    return outside, [f for f in files if f == contract or f.startswith(specs_dir + "/")]


def cmd_apply(args):
    """Carries a worktree's work over to the main tree, without any commit."""
    team = load_team()
    a = agent_by_name(team, args.agent)
    args.base, args.head, args.feature = None, None, None
    files, info, _ = files_of_agent(team, a, args)
    outside, forbidden = analyze_scope(team, a, files)
    if outside or forbidden:
        blocked("OUT_OF_SCOPE", "Nothing was applied.", out_of_scope=outside, spec_or_contract_touched=forbidden)
    if info.get("diverged_base"):
        d = info["diverged_base"]
        blocked("DIVERGED_BASE", d["message"], expected=d["expected"], actual=d["actual"])
    if not files:
        emit({"status": "nothing", "message": "No change in this worktree."})
    top = toplevel(ROOT / a.get("repo", "."))
    wt = Path(args.worktree)
    _, head = git(top, "rev-parse", "HEAD")
    git(wt, "add", "-A")
    patch = subprocess.run(["git", "-C", str(wt), "diff", "--cached", "--binary", head], capture_output=True).stdout
    r = subprocess.run(["git", "-C", str(top), "apply", "--whitespace=nowarn", "-"], input=patch, capture_output=True)
    if r.returncode != 0:
        blocked("CANNOT_APPLY", "The patch does not apply: conflict to arbitrate, nothing was changed.",
                detail=r.stderr.decode(errors="replace")[-800:])
    emit({"status": "ok", "files": files, "note": "Uncommitted changes in the main tree."})


def cmd_scope_check(args):
    team = load_team()
    a = agent_by_name(team, args.agent)
    files, info, resume = files_of_agent(team, a, args)
    outside, forbidden = analyze_scope(team, a, files)
    incident = bool(outside or forbidden)
    if resume:
        e, current = resume
        if incident:
            e["incidents"].append({"agent": a["name"], "date": now(), "out_of_scope": outside, "spec_or_contract": forbidden})
        else:
            e["baseline"] = current
        save_state(e)
    emit({"agent": a["name"], "scope": a.get("scope", []), "files": files, "out_of_scope": outside,
          "spec_or_contract_touched": forbidden, **info,
          "status": "incident" if incident else "ok"}, 2 if incident else 0)


def binary_present(cmd, cwd):
    try:
        words = shlex.split(cmd)
    except ValueError:
        return True
    for w in words:
        if "=" in w.split("/")[0]:
            continue
        if w in ("cd",):
            return True
        return bool(shutil.which(w)) or (cwd / w).exists()
    return True


def cmd_doctor(args):
    team = load_team(required=False)
    f = []

    def finding(id_, severity, summary, fix=None):
        f.append({"id": id_, "severity": severity, "summary": summary, "fix": fix})

    if team is None:
        finding("no-team", "route", "No .team/team.json.", "/team add or /team compose")
        emit({"findings": f})
    for p in validate_composition(team):
        finding("composition-" + p["code"].lower(), "route" if p["severity"] == "blocking" else "mention", p["message"], "/team compose")
    names = {a["name"] for a in active(team)}
    for a in active(team):
        for rel, content in agent_files(team, a):
            p = ROOT / rel
            if not p.is_file():
                finding("agent-missing", "auto", f"{rel} is missing.", "team scaffold")
            elif p.read_text(errors="replace") != content:
                finding("agent-drift", "mention", f"{rel} differs from team.json (manual edit or changed config).",
                        f"team scaffold then, after consent, --overwrite {rel}")
        cwd = ROOT / a.get("repo", ".")
        if not cwd.is_dir():
            finding("repo-missing", "route", f"{a['name']}: repository {a.get('repo')} not found.", "/team compose")
        elif a.get("verification") and not binary_present(a["verification"], cwd):
            finding("verification-not-found", "mention", f"{a['name']}: `{a['verification']}` does not look runnable here.")
        if a.get("role") == ROLE_DEV or a.get("role") == "tester":
            for s in a.get("scope", []):
                if not (ROOT / fixed_prefix(s)).exists():
                    finding("scope-missing", "mention", f"{a['name']}: {s} does not exist yet.")
    for agents_dir, pattern, mark in ((".claude/agents", "*.md", AGENT_MARK), (".codex/agents", "*.toml", CODEX_MARK)):
        for p in (ROOT / agents_dir).glob(pattern):
            if mark in p.read_text(errors="replace") and p.stem not in names:
                finding("agent-orphan", "mention", f"{agents_dir}/{p.name} was generated by team but the agent is no longer active.", "delete after consent")
    contract = contract_path(team)
    if contract and not contract.is_file():
        finding("contract-missing", "auto", f"{team['project']['contract']} is missing.", "team scaffold")
    section = render_rules_section(team)
    for name in rule_files(team):
        target = ROOT / name
        if not target.is_file() or SECTION_START not in target.read_text(errors="replace"):
            finding("rules-section-missing", "route", f"{name} has no Agent team section.", f"team scaffold --overwrite {name} after consent")
        elif section.strip() not in target.read_text(errors="replace"):
            finding("rules-section-drift", "mention", f"The Agent team section of {name} no longer matches team.json.", f"team scaffold --overwrite {name} after consent")
    for r in state_summaries():
        e = load_state(r["feature"])
        if e.get("approval") and e["phase"] not in ("done", "stopped") and e["approval"]["hash"] != approval_hash(team, r["feature"]):
            finding("spec-changed-after-approval", "route", f"{r['feature']}: spec or contract changed since the go-ahead.", "/team plan")
        if e.get("incidents") and e["phase"] not in ("done", "stopped"):
            finding("open-incidents", "mention", f"{r['feature']}: {len(e['incidents'])} scope incident(s) recorded.")
    for top in team_repos(team):
        _, listing = git(top, "worktree", "list", "--porcelain")
        n = sum(1 for l in listing.splitlines() if l.startswith("worktree ")) - 1
        if n > 0:
            finding("leftover-worktrees", "mention", f"{top.name}: {n} worktree(s) besides the main tree.", "git worktree list, clean up after integration")
    emit({"findings": f})


def cmd_status(args):
    load_team()
    if args.feature:
        emit(load_state(args.feature))
    emit({"features": state_summaries()})


def main():
    p = argparse.ArgumentParser(prog="team", description="Facts and guardrails of the team skill.")
    s = p.add_subparsers(dest="command", required=True)
    s.add_parser("context").set_defaults(fn=cmd_context)
    s.add_parser("catalog").set_defaults(fn=cmd_catalog)
    x = s.add_parser("propose")
    x.add_argument("agents", nargs="+")
    x.add_argument("--write", action="store_true")
    x.set_defaults(fn=cmd_propose)
    x = s.add_parser("scaffold")
    x.add_argument("--dry-run", action="store_true")
    x.add_argument("--overwrite", action="append")
    x.set_defaults(fn=cmd_scaffold)
    x = s.add_parser("preflight")
    x.add_argument("feature", nargs="?")
    x.set_defaults(fn=cmd_preflight)
    x = s.add_parser("start")
    x.add_argument("feature")
    x.set_defaults(fn=cmd_start)
    x = s.add_parser("approve")
    x.add_argument("feature")
    x.add_argument("--quote", required=True)
    x.set_defaults(fn=cmd_approve)
    x = s.add_parser("advance")
    x.add_argument("feature")
    x.add_argument("phase", choices=sorted(ORDER))
    x.set_defaults(fn=cmd_advance)
    x = s.add_parser("round")
    x.add_argument("feature")
    x.set_defaults(fn=cmd_round)
    x = s.add_parser("stop")
    x.add_argument("feature")
    x.add_argument("--reason", required=True)
    x.set_defaults(fn=cmd_stop)
    x = s.add_parser("verify")
    x.add_argument("feature")
    g = x.add_mutually_exclusive_group(required=True)
    g.add_argument("--agent")
    g.add_argument("--all", action="store_true")
    x.add_argument("--timeout", type=int, default=900)
    x.set_defaults(fn=cmd_verify)
    x = s.add_parser("apply")
    x.add_argument("agent")
    x.add_argument("--worktree", required=True)
    x.set_defaults(fn=cmd_apply)
    x = s.add_parser("scope-check")
    x.add_argument("agent")
    x.add_argument("--feature")
    x.add_argument("--worktree")
    x.add_argument("--base")
    x.add_argument("--head")
    x.set_defaults(fn=cmd_scope_check)
    s.add_parser("doctor").set_defaults(fn=cmd_doctor)
    x = s.add_parser("status")
    x.add_argument("feature", nargs="?")
    x.set_defaults(fn=cmd_status)
    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
